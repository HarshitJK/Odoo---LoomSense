# ---- Backend (copy to backend/.env; see backend/.env.example) ----
MONGODB_URI=mongodb://localhost:27017
DB_NAME=loomsense
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Public frontend URL used inside passport QR codes
PASSPORT_BASE_URL=http://localhost:5173
# Needed for POST /api/demo/reset (X-Admin-Key header); use a long random value when deployed
ADMIN_KEY=change-me
# Set to false to start the machine simulator paused
SIMULATOR_AUTOSTART=true

# ---- Frontend (copy to frontend/.env) ----
# VITE_API_URL=http://localhost:8000
