# Copy to .env to change settings. Everything has a default, so `docker compose up --build` works without this file.

# ---- Docker ports ----
FRONTEND_PORT=5173
BACKEND_PORT=8000
# MongoDB port on your machine (for MongoDB Compass). Change it if you already run MongoDB locally.
MONGO_PORT=27017

# ---- Addresses the BROWSER uses ----
# VITE_API_URL is baked into the frontend at BUILD time: after changing it run `docker compose up --build`.
# For a phone on the same wifi, use your computer's LAN IP instead of localhost, for example:
#   VITE_API_URL=http://192.168.1.20:8000
#   CORS_ORIGINS=http://192.168.1.20:5173
#   PASSPORT_BASE_URL=http://192.168.1.20:5173     (QR codes on printed passports open this address)
VITE_API_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
PASSPORT_BASE_URL=http://localhost:5173
# Public frontend URL used in private buyer tracking links ({TRACKING_BASE_URL}/track/{token}); defaults to PASSPORT_BASE_URL when empty
TRACKING_BASE_URL=

# ---- Backend ----
DB_NAME=loomsense
# Needed for POST /api/demo/reset (X-Admin-Key header). Use a long random value if the stack is reachable by others.
ADMIN_KEY=change-me
# Start explicitly at demo time; also keep false when using the feeder.
SIMULATOR_AUTOSTART=false
# Pin dashboard, trend and month-end defaults to the seeded month; blank uses the server month outside compose.
DEMO_MONTH=2026-10
# Demo-only opt-in: changed seed versions replace operational demo data. Disable to retain manual entries.
AUTO_RESEED_ON_VERSION_CHANGE=true
# true = reload demo data even if orders exist and the seed version matches.
FORCE_SEED=false
# Seconds between sample readings in feeder mode
FEEDER_DELAY_SECONDS=3

# ---- MongoDB Atlas instead of the local container ----
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# then start with: docker compose -f docker-compose.yml -f docker-compose.atlas.yml up --build
# (plain `python run.py` / uvicorn without Docker reads backend/.env, see backend/.env.example)

# Required: set your own random JWT secret (at least 32 characters).
JWT_SECRET=
# Configure before seeding/migrating. Minimum 12 characters; no built-in passwords.
SEED_OWNER_PASSWORD=
SEED_PRODUCTION_MANAGER_PASSWORD=
SEED_WORKER_QC_PASSWORD=
# External machine feeder: obtain a manager token through /api/auth/login.
FEEDER_TOKEN=
