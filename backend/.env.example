# Copy this file to .env (never commit .env)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=loomsense
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
SIMULATOR_AUTOSTART=true
PASSPORT_BASE_URL=http://localhost:5173
# Needed for POST /api/demo/reset (send it as the X-Admin-Key header); pick a long random value in production
ADMIN_KEY=change-me

# Required: set your own random JWT secret (at least 32 characters).
JWT_SECRET=
# Configure before seeding/migrating. Minimum 12 characters; no built-in passwords.
SEED_OWNER_PASSWORD=
SEED_PRODUCTION_MANAGER_PASSWORD=
SEED_WORKER_QC_PASSWORD=
# External machine feeder: obtain a manager token through /api/auth/login.
FEEDER_TOKEN=
